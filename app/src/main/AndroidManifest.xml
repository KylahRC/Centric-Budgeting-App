<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/applogo1"
        android:label="@string/app_name"
        android:roundIcon="@drawable/applogo1"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".SplitExpenseActivity"
            android:exported="true" />
        <activity
            android:name=".Register"
            android:exported="false"
            android:theme="@style/Theme.Material3.Dark.NoActionBar" />
        <activity
            android:name=".Login"
            android:exported="true"
            android:theme="@style/Theme.Material3.Dark.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:theme="@style/Theme.Material3.Dark.NoActionBar" />
        <activity
            android:name=".AddCategoryActivity"
            android:exported="true"
            android:theme="@style/Theme.Material3.Dark.NoActionBar" />
        <activity
            android:name=".AddExpenseActivity"
            android:exported="true"
            android:theme="@style/Theme.Material3.Dark.NoActionBar" />
        <activity
            android:name=".BudgetGoalsActivity"
            android:exported="true"
            android:theme="@style/Theme.Material3.Dark.NoActionBar" />
        <activity
            android:name=".ViewExpensesActivity"
            android:exported="true"
            android:theme="@style/Theme.Material3.Dark.NoActionBar" />
        <activity
            android:name=".CategoryTotalsActivity"
            android:exported="true"
            android:theme="@style/Theme.Material3.Dark.NoActionBar" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Material3.Dark.NoActionBar">

        </activity>
    </application>

</manifest>